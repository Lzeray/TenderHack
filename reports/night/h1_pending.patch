diff --git a/tests/test_plan_core.py b/tests/test_plan_core.py
index 8702c0e..ce4587f 100644
--- a/tests/test_plan_core.py
+++ b/tests/test_plan_core.py
@@ -320,3 +320,10 @@ def test_numbered_value_needs_its_number(engine, tmp_path):
     from ktru_assist.nlp.extract import _LEAD_NUMBER
     assert _LEAD_NUMBER.match("2 (III климатический пояс)").group(1) == "2"
     assert _LEAD_NUMBER.match("Металл") is None
+def test_unexplained_number_blocks_auto_code(engine):
+    # число без свойства не игнорируется молча: код только после подтверждения
+    r = search(engine, "пассатижи слесарные 190 мм, 12345 штук в упаковке")
+    assert r.final_code is None and any(i.code == "number_unexplained" for i in r.issues)
+    assert r.question.kind == "confirm"
+    r2 = search(engine, "пассатижи слесарные 190 мм, 12345 штук в упаковке", confirmed=r.question.options[0].confirm)
+    assert r2.status == "matched"
